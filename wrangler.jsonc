{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-task-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-task-hub-db",
      "database_id": "7738647f-096a-4597-affe-e8b2ff5f61d4",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "AccountCoordinator"
      },
      {
        "name": "PASSWORDS",
        "class_name": "PasswordHasher"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AccountCoordinator"
      ]
    },
    {
      "tag": "v2-password-hasher",
      "new_sqlite_classes": [
        "PasswordHasher"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TASK_QUEUE",
        "queue": "cf-task-hub-queue"
      }
    ],
    "consumers": [
      {
        "queue": "cf-task-hub-queue",
        "max_batch_size": 1,
        "max_retries": 2,
        "dead_letter_queue": "cf-task-hub-dlq",
        "max_batch_timeout": 1,
        "max_concurrency": 2,
        "retry_delay": 60
      },
      {
        "queue": "cf-task-hub-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        "retry_delay": 60
      }
    ]
  },
  "vars": {
    "APP_TITLE": "CF Task Hub",
    "MAINTENANCE_MODE": "false",
    "DLQ_NAME": "cf-task-hub-dlq",
    "APP_ORIGIN": "https://task.awakaze.com",
    "API_PAUSED": "false",
    "BACKGROUND_PAUSED": "false"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true
}
